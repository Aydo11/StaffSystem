# Copy to .env for local development. Never commit .env. No real secrets belong in this file.

# Postgres. Local: `npm run db:local` starts one at this address. Render: the database's Internal Database URL.
DATABASE_URL=postgres://hub:hub@localhost:5432/hub
# DATABASE_CA=                  # only for a database reached over the internet: its CA certificate (PEM; \n allowed)
# DATABASE_SSL=false            # development only: a non-localhost database without TLS
# DATABASE_POOL_MAX=10

# Email (optional). Invitations and password resets are emailed when both are set; otherwise admins get a link to pass on.
# RESEND_API_KEY=
# EMAIL_FROM=Hub <hub@yourdomain.example>

# AI assistant (optional, off per company until switched on in Admin Centre).
# ANTHROPIC_API_KEY=

# Local development only. Enables "Demo sign-in" for the fictional seeded accounts. Refused when NODE_ENV=production.
DEV_AUTH=true

# Ports: the API listens on API_PORT (or PORT on Render). Vite serves the web app on 5173 and proxies /api.
API_PORT=3000
APP_URL=http://localhost:5173
HELP_CONTACT=
# RATE_LIMIT_PER_MIN=600
