# Copy to .env for local development. Never commit .env. No real secrets belong in this file.

# Postgres. Local: `npm run db:local` starts one at this address. Production: Supabase connection string.
DATABASE_URL=postgres://hub:hub@localhost:5432/hub
# DATABASE_CA=                  # remote databases: the provider's CA certificate (PEM; 
 allowed). Required in production.
# DATABASE_SSL=false            # development only: a non-localhost database without TLS
# DATABASE_POOL_MAX=10

# Supabase (sign-in, MFA, private file storage). Leave blank locally to use demo sign-in and database file storage.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Local development only. Enables "Demo sign-in" for the fictional seeded accounts. Refused when NODE_ENV=production.
DEV_AUTH=true
# DEV_AUTH_SECRET=change-me-locally

# Ports: the API listens on API_PORT (or PORT on Render). Vite serves the web app on 5173 and proxies /api.
API_PORT=3000
APP_URL=http://localhost:5173
HELP_CONTACT=
# RATE_LIMIT_PER_MIN=600
